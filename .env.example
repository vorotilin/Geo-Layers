# ============================================================
# apc-layers — переменные окружения
# Скопируйте в .env и заполните. Секреты в репозиторий не коммитить.
# ============================================================

# --- Общее ---
# Режим работы: dev | prod
APP_ENV=
# Уровень логирования: debug | info | warn | error
LOG_LEVEL=
# Порт HTTP-сервера
HTTP_PORT=

# --- Аутентификация ---
# Токены доступа (Bearer). Хранятся хэшем. Несколько токенов через запятую,
# у каждого область: admin | write | read.
# Формат: <хэш>:<scope>,<хэш>:<scope>
AUTH_TOKENS=

# --- Подпись callback'ов и публичных ссылок ---
# Секрет HMAC-SHA256 для подписи callback'ов в платформу.
CALLBACK_SIGNING_SECRET=
# Секрет HMAC для подписанных URL (тайлы, превью). HMAC от пути и exp.
URL_SIGNING_SECRET=
# Срок жизни подписанной ссылки, секунды
SIGNED_URL_TTL_SECONDS=

# --- Хранилище S3 (MinIO локально) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# --- База данных ---
DATABASE_URL=

# --- Очередь заданий ---
QUEUE_URL=

# --- Лимиты (раздел «Лимиты» общих требований) ---
# Максимальный размер входного файла, байт
MAX_UPLOAD_BYTES=
# Максимальная длительность обработки задания, секунды
MAX_JOB_DURATION_SECONDS=
# Максимум одновременных заданий на токен
MAX_CONCURRENT_JOBS_PER_TOKEN=
# Rate limit на публичных/дорогих ручках, запросов в секунду
RATE_LIMIT_RPS=

# --- Внешние утилиты (вызовом процесса) ---
# Путь к GDAL, если используется
GDAL_BIN=