# ============================================================
# apc-layers — переменные окружения
# Скопируйте в .env и заполните. Секреты в репозиторий не коммитить.
# ============================================================

# --- Общее ---
# Режим работы: dev | prod (в dev включён Swagger UI на /docs)
APP_ENV=
# Уровень логирования: debug | info | warn | error
LOG_LEVEL=
# Порт HTTP-сервера
HTTP_PORT=
# Публичный базовый URL сервиса (для шаблонов URL тайлов и status_url)
PUBLIC_BASE_URL=
# Разрешённые origin для CORS, через запятую
CORS_ORIGINS=

# --- Аутентификация ---
# Токены хранятся в БД (хэшем) и управляются через /v1/tokens, отзыв без перезапуска.
# Этот токен создаётся как admin только при пустой таблице токенов (первый запуск).
BOOTSTRAP_ADMIN_TOKEN=
# Basic auth для веб-интерфейса (необязательно; иначе вход по токену)
UI_BASIC_AUTH_USER=
UI_BASIC_AUTH_PASSWORD=

# --- Подпись callback'ов и публичных ссылок ---
# Секрет HMAC-SHA256 для подписи callback'ов в платформу
CALLBACK_SIGNING_SECRET=
# Секрет HMAC для подписанных URL (тайлы, значения). Текущий.
URL_SIGNING_SECRET=
# Предыдущий секрет: принимается при проверке во время ротации (можно пусто)
URL_SIGNING_SECRET_PREVIOUS=
# Срок жизни подписанной ссылки по умолчанию, секунды (округляется вверх, см. ниже)
SIGNED_URL_TTL_SECONDS=
# Шаг округления срока подписи вверх, секунды. Больше шаг — дольше стабилен URL
# (лучше кэш браузера), но ссылка может прожить дольше запрошенного на этот шаг.
# По умолчанию 3600 (1 час); 86400 — сутки.
SIGN_EXP_ROUNDING_SECONDS=3600

# --- Хранилище S3 (MinIO локально) ---
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# --- База данных (PostgreSQL + PostGIS) ---
DATABASE_URL=

# --- Redis (rate limit) ---
REDIS_URL=

# --- Локальный кэш (массивы значений, тайлы индексов, PNG) ---
# Каталог на общем volume api и worker
CACHE_DIR=
# Предельный объём дискового кэша, МБ (вытеснение старых файлов)
CACHE_MAX_MB=

# --- Лимиты ---
# Максимальный размер входного файла, байт
MAX_UPLOAD_BYTES=
# Максимальный размер файла, скачиваемого по ссылке, байт
MAX_DOWNLOAD_BYTES=
# Максимальная длительность обработки задания, секунды
MAX_JOB_DURATION_SECONDS=
# Лимит памяти подпроцесса разбора файлов, МБ
PARSER_MEMORY_LIMIT_MB=
# Сколько тяжёлых заданий воркер выполняет одновременно
WORKER_CONCURRENCY=
# Максимум одновременных заданий на токен
MAX_CONCURRENT_JOBS_PER_TOKEN=
# Rate limit на публичных ручках, запросов в секунду на токен/подпись
RATE_LIMIT_RPS=
# Rate limit на дорогих ручках (batch, aggregate), запросов в секунду
RATE_LIMIT_EXPENSIVE_RPS=
# Максимум точек в одном запросе /v1/values/batch
MAX_BATCH_POINTS=

# --- Персональные данные ---
# Срок хранения наборов точек, дни: наборы, не пополнявшиеся дольше срока,
# удаляются служебным заданием раз в сутки. Пусто — хранить бессрочно.
POINT_SETS_RETENTION_DAYS=
